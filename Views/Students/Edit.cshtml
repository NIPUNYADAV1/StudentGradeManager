@model GradeEntry
@{
    ViewData["Title"] = "Edit grade";
    ViewData["SubmitLabel"] = "Save changes";
}

<section class="form-page">
    <a asp-action="Index" class="back-link">← Back to grades</a>
    <div class="form-card">
        <div class="form-title">
            <p class="eyebrow">UPDATE RECORD</p>
            <h1>Edit grade</h1>
            <p>Update the student and course details below.</p>
        </div>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_GradeForm" model="Model" />
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
